{
  "name": "scheduloscope",
  "version": "1.0.2",
  "description": "Design-time real-time scheduling analysis, simulation, and on-target workload generation for QNX 8.0",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fetachino/qnx-scheduloscope.git"
  },
  "homepage": "https://fetachino.github.io/qnx-scheduloscope/",
  "bugs": {
    "url": "https://github.com/fetachino/qnx-scheduloscope/issues"
  },
  "type": "module",
  "bin": {
    "scheduloscope": "dist/src/cli/main.js",
    "slscope": "dist/src/cli/main.js"
  },
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "docs/analysis-method.md",
    "docs/demo-tour.md",
    "docs/model-reference.md",
    "docs/qnx-semantics.md",
    "docs/qnx-native-boot.txt",
    "docs/qnx-aarch64-boot.txt",
    "docs/qnx-aarch64-report.json",
    "docs/verification.md",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "test:only": "node scripts/test.mjs",
    "check:c": "node scripts/c-harness-check.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "build:pages": "node scripts/build-pages.mjs",
    "demo": "node dist/src/cli/main.js report examples/motor-control.yaml --html demo/motor-control.html --md demo/motor-control.md",
    "bench": "node dist/bench/run.js"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  },
  "keywords": [
    "qnx",
    "real-time",
    "scheduling",
    "embedded",
    "rtos",
    "response-time-analysis"
  ]
}
