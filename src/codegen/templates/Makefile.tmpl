# Generated by Scheduloscope {{VERSION}} for model "{{SYSTEM_NAME}}".
#
#   make        build and run on the host (POSIX backend, no real-time guarantees)
#   make qnx    build with the QNX SDP 8.0 toolchain (x86_64)
#   make qnx-arm  build for aarch64le
#   make run    run the host build for one hyperperiod

CC ?= cc
CFLAGS ?= -O2 -g -Wall -Wextra -std=c11 -D_GNU_SOURCE
LDLIBS ?= -lpthread -lrt

COMMON = harness.c workload.h platform.h
TARGET = scheduloscope-harness

.PHONY: all host qnx qnx-arm run clean

all: host

host: $(TARGET)

$(TARGET): $(COMMON) platform_posix.c
	$(CC) $(CFLAGS) -o $@ harness.c platform_posix.c $(LDLIBS)

qnx:
	qcc -V gcc_ntox86_64 -O2 -g -Wall -Wextra -std=c11 -o $(TARGET) harness.c platform_qnx.c

qnx-arm:
	qcc -V gcc_ntoaarch64le -O2 -g -Wall -Wextra -std=c11 -o $(TARGET) harness.c platform_qnx.c

run: host
	./$(TARGET) -o report.json

clean:
	rm -f $(TARGET) report.json
