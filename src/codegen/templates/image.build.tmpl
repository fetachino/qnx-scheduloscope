# mkifs build script template for a bootable x86_64 QNX image that starts the
# measurement harness. Adjust paths to your SDP installation and to your board.
#
#   source ~/qnx800/qnxsdp-env.sh
#   mkifs -v image.build.template image.ifs
#
# This is a starting point, not a tested boot image: it has not been built or
# booted in this project because the QNX SDP was not available.
# The harness is dynamically linked. QNX 8 images need libc.so, libgcc_s.so.1
# and the dynamic loader ldqnx-64.so.2; the loader must be reachable at the
# absolute path /usr/lib/ldqnx-64.so.2 recorded as the ELF interpreter.

[virtual=x86_64,elf] .bootstrap = {
    startup-x86_64 -v
    PATH=/proc/boot:/bin:/usr/bin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib
    procnto-smp-instr -P 63
}

[+script] .script = {
    devc-ser8250
    pipe
    # /tmp is the in-image, writable directory created below.
    /proc/boot/scheduloscope-harness -d 30000 -o /tmp/report.json
}

# In-memory directory the harness can write to even without a disk driver.
[type=dir perms=0777] /tmp

[data=copy] /proc/boot = {
    scheduloscope-harness
    $QNX_TARGET/x86_64/lib/ldqnx-64.so.2
    $QNX_TARGET/x86_64/lib/libc.so
    $QNX_TARGET/x86_64/lib/libgcc_s.so.1
}
[type=link] /usr/lib/ldqnx-64.so.2=/proc/boot/ldqnx-64.so.2

# System: {{SYSTEM_NAME}}
