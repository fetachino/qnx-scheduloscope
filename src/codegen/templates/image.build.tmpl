# mkifs build script for a bootable x86_64 QNX image that starts the
# measurement harness. Built with QNX SDP 8.0.6; adjust ${QNX_TARGET} if your
# SDP is installed elsewhere.
#
#   source ~/qnx800/qnxsdp-env.sh
#   mkifs -v image.build.template image.ifs
#
# The harness is dynamically linked. QNX 8.0.6 installs the loader under
# ${QNX_TARGET}/x86_64/usr/lib and the libraries under .../lib or .../usr/lib;
# the names below are the versioned files the linker actually records. The
# [type=link] entries put the loader at the absolute path recorded as the ELF
# interpreter and make the boot script's `cat` command available.
#
# mkifs does not search the current directory, so the harness source is spelled
# ./scheduloscope-harness; run mkifs from this directory.

# The QNX BIOS IPL (ipl-diskpc1 + ipl-diskpc2-fsq6) boots a
# [virtual=x86_64,bios] image. The multiboot and ELF variants retain a
# multiboot header, which ipl-diskpc2-fsq6 rejects as "Unsupported Multi-Boot".
# The 8 MB image base leaves room for the BIOS preboot header and all libraries.
[image=8m]
[virtual=x86_64,bios] .bootstrap = {
    startup-x86 -D8250..115200 -zz
    PATH=/proc/boot:/system/bin:/bin:/usr/bin:/sbin LD_LIBRARY_PATH=/proc/boot:/system/lib:/lib:/usr/lib
    procnto-smp-instr -P 63
}

[+script] .script = {
    # The serial manager is a daemon; without & the script never reaches the harness.
    devc-ser8250 &
    pipe
    # Put the harness output on the serial console as well as in the JSON file.
    reopen /dev/ser1
    # /tmp is a link to the kernel's in-memory /dev/shmem, which is writable.
    /proc/boot/scheduloscope-harness -d 30000 -o /tmp/report.json
    cat /tmp/report.json
}

# The IFS is mounted read-only, so /tmp cannot be a plain image directory.
[type=link] /tmp=/dev/shmem
# The ELF interpreter path must resolve to the loader in /proc/boot.
[type=link] /usr/lib/ldqnx-64.so.2=/proc/boot/ldqnx-64.so.2
# `cat` is a toybox applet in the QNX 8 target; link the name the script uses.
[type=link] cat=toybox

# mkifs' default prefix is proc/boot: these entries land in /proc/boot.
[uid=0 gid=0 perms=0755] scheduloscope-harness=./scheduloscope-harness
toybox
devc-ser8250=${QNX_TARGET}/x86_64/sbin/devc-ser8250
pipe=${QNX_TARGET}/x86_64/sbin/pipe
${QNX_TARGET}/x86_64/usr/lib/ldqnx-64.so.2
${QNX_TARGET}/x86_64/lib/libc.so.6
${QNX_TARGET}/x86_64/lib/libgcc_s.so.1
${QNX_TARGET}/x86_64/lib/libm.so.3
${QNX_TARGET}/x86_64/usr/lib/libz.so.2
${QNX_TARGET}/x86_64/lib/libtracelog.so.1
${QNX_TARGET}/x86_64/lib/libsecpol.so.1
${QNX_TARGET}/x86_64/lib/libfsnotify.so.1

# QNX 8 privileged services (devc-ser8250, pipe) resolve their full
# dependency chain from the trusted /system/lib path. The /proc/boot copies
# alone are enough for the harness but not for secure drivers, which report
# "ldd:FATAL: Could not load library libsecpol.so.1" and lose the serial port.
# Use real files here: a /system/lib symlink to /proc/boot is not followed by
# the secure loader.
/system/lib/ldqnx-64.so.2=${QNX_TARGET}/x86_64/usr/lib/ldqnx-64.so.2
/system/lib/libc.so.6=${QNX_TARGET}/x86_64/lib/libc.so.6
/system/lib/libgcc_s.so.1=${QNX_TARGET}/x86_64/lib/libgcc_s.so.1
/system/lib/libm.so.3=${QNX_TARGET}/x86_64/lib/libm.so.3
/system/lib/libz.so.2=${QNX_TARGET}/x86_64/usr/lib/libz.so.2
/system/lib/libtracelog.so.1=${QNX_TARGET}/x86_64/lib/libtracelog.so.1
/system/lib/libsecpol.so.1=${QNX_TARGET}/x86_64/lib/libsecpol.so.1
/system/lib/libfsnotify.so.1=${QNX_TARGET}/x86_64/lib/libfsnotify.so.1

# System: {{SYSTEM_NAME}}
